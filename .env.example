# Tempo Reader Revenue Brain Environment Variables
# Copy this to .env and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
ADMIN_EMAIL="admin@tempo.co.id"
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# Demo Mode (always true for MVP)
DEMO_MODE="true"

# Feature Flags
ENABLE_NEWS_MOMENTS="true"
ENABLE_COPILOT="true"
ENABLE_LTV="true"
ENABLE_CHURN="true"
ENABLE_SHADOW_MODE="true"

# OpenAI (optional - used for Copilot summaries)
OPENAI_API_KEY=""

# Execution Mode (SHADOW | CONTROLLED | LIVE)
EXECUTION_MODE="LIVE"

# Traffic Rollout (0-100)
TRAFFIC_ROLLOUT="100"
